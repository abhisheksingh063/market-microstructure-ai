# ── Environment ──────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── API ─────────────────────────────────────────────────
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Database ────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./mmsim.db
# DATABASE_URL=postgresql+asyncpg://mmuser:mmpass@localhost:5432/mmsim
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ── Redis (optional) ────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ── Simulation ──────────────────────────────────────────
SIM_TOTAL_STEPS=1000
SIM_TICK_DURATION_MS=100
SIM_INITIAL_MID_PRICE=100.0
SIM_INITIAL_SPREAD=0.5
SIM_MAX_AGENTS=100
SIM_ORDER_EXPIRY_STEPS=100

# ── Agents ──────────────────────────────────────────────
AGENT_DEFAULT_CASH=100000.0
AGENT_DEFAULT_SPREAD_BPS=5
AGENT_DEFAULT_QUOTE_SIZE=10

# ── Random Seed ─────────────────────────────────────────
# RANDOM_SEED=42

# ── RL / Training ───────────────────────────────────────
RL_MAX_STEPS=1000
RL_LEARNING_RATE=0.0003
RL_GAMMA=0.99
RL_BATCH_SIZE=64

# ── WebSocket ───────────────────────────────────────────
WS_MAX_CONNECTIONS=1000
WS_RECONNECT_DELAY_SEC=3.0

# ── Logging ─────────────────────────────────────────────
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
